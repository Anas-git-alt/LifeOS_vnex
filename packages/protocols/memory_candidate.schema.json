{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/protocols/memory_candidate.schema.json",
  "title": "LifeOS Memory Candidate",
  "type": "object",
  "required": ["candidate_id", "kind", "domain", "statement", "evidence_refs", "confidence", "sensitivity", "review_policy"],
  "properties": {
    "candidate_id": { "type": "string" },
    "kind": { "type": "string" },
    "domain": { "type": "string" },
    "statement": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "object" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sensitivity": { "type": "string" },
    "review_policy": { "type": "string" },
    "possible_contradictions": { "type": "array" },
    "proposed_wiki_update": { "type": "object" }
  }
}
