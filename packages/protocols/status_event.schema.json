{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/protocols/status_event.schema.json",
  "title": "LifeOS Status Event",
  "type": "object",
  "required": ["id", "event_type", "visibility", "title", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "event_type": { "type": "string" },
    "visibility": { "enum": ["hidden", "discord_compact", "discord_verbose", "web_only"] },
    "title": { "type": "string" },
    "detail_json": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
