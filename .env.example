# Runtime
LIFEOS_ENV=development
LIFEOS_TIMEZONE=Africa/Casablanca
LIFEOS_VAULT_PATH=/app/vault
LIFEOS_API_BASE_URL=http://api:8000
LIFEOS_GATEWAY_API_BASE_URL=http://api:8000

# Database and queue
DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@postgres:5432/lifeos
REDIS_URL=redis://redis:6379/0

# Discord gateway
DISCORD_BOT_TOKEN=
DISCORD_OWNER_USER_ID=
DISCORD_GUILD_ID=
DISCORD_APPROVAL_CHANNEL_ID=
DISCORD_DASHBOARD_CHANNEL_ID=
DISCORD_DAILY_PLAN_CHANNEL_ID=
DISCORD_QUICK_CAPTURE_CHANNEL_ID=
DISCORD_BOT_TESTING_CHANNEL_ID=
DISCORD_WORK_TRACKER_CHANNEL_ID=
DISCORD_FINANCE_TRACKER_CHANNEL_ID=
DISCORD_PRAYER_TRACKER_CHANNEL_ID=
DISCORD_HABITS_HEALTH_CHANNEL_ID=
DISCORD_FAMILY_COMMITMENTS_CHANNEL_ID=
DISCORD_AGENT_HANDOFFS_CHANNEL_ID=
DISCORD_AGENT_RUNS_CHANNEL_ID=
DISCORD_MEMORY_REVIEW_CHANNEL_ID=
DISCORD_RESEARCH_LAB_CHANNEL_ID=
DISCORD_SYSTEM_NOTIFICATIONS_CHANNEL_ID=
DISCORD_AUDIT_LOG_CHANNEL_ID=
DISCORD_DEAD_LETTER_CHANNEL_ID=
DISCORD_POST_EXISTING_ON_STARTUP=false
LIFEOS_GATEWAY_DRY_RUN=false

# Telegram gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# Providers
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
NVIDIA_NIM_API_KEY_1=
NVIDIA_NIM_API_KEY_2=

# Codex OAuth cache path, mounted as a secret in real deployments
CODEX_HOME=/secrets/codex

# Web
VITE_LIFEOS_API_URL=
VITE_LIFEOS_EVENTS_URL=/api/events
